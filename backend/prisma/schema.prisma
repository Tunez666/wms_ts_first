generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  WAREHOUSE_MANAGER
  RECEIVER
  WAREHOUSE_OPERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum ZoneType {
  RECEIVING
  STORAGE
  SHIPPING
  QUARANTINE
  RETURN
  OTHER
}

enum LocationStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

enum LocationType {
  BIN
  FLOOR
  SHELF
  PALLET
  STAGING
  OTHER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum RequestStatus {
  CREATED
  IN_PROGRESS
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum RequestOperationType {
  RECEIVING
  PUTAWAY
  MOVE
  INVENTORY_CHECK
}

enum RequestOperationStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReceivingStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BoxStatus {
  OPEN
  SEALED
  STORED
  CLOSED
  CANCELLED
}

enum InventoryMovementType {
  RECEIPT
  PUTAWAY
  MOVE
  ADJUSTMENT
  WRITE_OFF
  INVENTORY_CORRECTION
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  RECEIVE
  PUTAWAY
  MOVE
  ADJUST
  ASSIGN
  COMPLETE
  CANCEL
}

// ============================================================
// USER
// ============================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  login        String     @unique @db.VarChar(100)
  passwordHash String     @db.VarChar(255)
  firstName    String     @db.VarChar(100)
  lastName     String     @db.VarChar(100)
  role         UserRole   @default(WAREHOUSE_OPERATOR)
  status       UserStatus @default(ACTIVE)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastLoginAt DateTime?

  createdRequests  Request[]          @relation("RequestCreatedBy")
  assignedRequests Request[]          @relation("RequestAssignedTo")

  assignedOperations  RequestOperation[] @relation("OperationAssignedTo")
  completedOperations RequestOperation[] @relation("OperationCompletedBy")

  receivedReceivings Receiving[] @relation("ReceivingReceivedBy")

  movedBoxes BoxMovement[] @relation("BoxMovementMovedBy")

  performedInventoryMovements InventoryMovement[] @relation("InventoryMovementPerformedBy")

  auditLogs AuditLog[]

  @@index([role])
  @@index([status])
  @@map("users")
}

// ============================================================
// WAREHOUSE
// ============================================================

model Warehouse {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique @db.VarChar(50)
  name        String          @db.VarChar(150)
  description String?         @db.Text
  status      WarehouseStatus @default(ACTIVE)

  address String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zones      Zone[]
  locations  Location[]
  products   Inventory[]
  requests   Request[]
  receivings Receiving[]
  boxes      Box[]
  movements  InventoryMovement[]

  @@index([status])
  @@map("warehouses")
}

// ============================================================
// ZONE
// ============================================================

model Zone {
  id          String   @id @default(uuid()) @db.Uuid
  warehouseId String   @db.Uuid

  code        String   @db.VarChar(50)
  name        String   @db.VarChar(150)
  type        ZoneType
  description String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  locations Location[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([type])
  @@map("zones")
}

// ============================================================
// LOCATION
// ============================================================

model Location {
  id          String         @id @default(uuid()) @db.Uuid
  warehouseId String         @db.Uuid
  zoneId      String?        @db.Uuid

  code        String       @db.VarChar(100)
  name        String?      @db.VarChar(150)
  type        LocationType @default(BIN)
  status      LocationStatus @default(ACTIVE)

  capacity    Int?
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  zone Zone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  boxes     Box[]
  inventory Inventory[]

  boxMovementsFrom BoxMovement[] @relation("BoxMovementFromLocation")
  boxMovementsTo   BoxMovement[] @relation("BoxMovementToLocation")

  inventoryMovementsFrom InventoryMovement[] @relation("InventoryMovementFromLocation")
  inventoryMovementsTo   InventoryMovement[] @relation("InventoryMovementToLocation")

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([zoneId])
  @@index([status])
  @@map("locations")
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  sku         String        @unique @db.VarChar(100)
  name        String        @db.VarChar(255)
  description String?       @db.Text
  status      ProductStatus @default(ACTIVE)

  barcode String? @unique @db.VarChar(100)

  unit String @default("pcs") @db.VarChar(30)

  weight Decimal? @db.Decimal(12, 3)
  length Decimal? @db.Decimal(12, 3)
  width  Decimal? @db.Decimal(12, 3)
  height Decimal? @db.Decimal(12, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestItems    RequestItem[]
  receivingItems  ReceivingItem[]
  boxItems        BoxItem[]
  inventory       Inventory[]
  inventoryMovements InventoryMovement[]

  @@index([status])
  @@index([name])
  @@map("products")
}

// ============================================================
// REQUEST
// ============================================================

model Request {
  id     String @id @default(uuid()) @db.Uuid
  number String @unique @db.VarChar(50)

  warehouseId  String  @db.Uuid
  createdById  String  @db.Uuid
  assignedToId String? @db.Uuid

  status RequestStatus @default(CREATED)

  description String? @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  cancelledAt DateTime?

  warehouse  Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy  User      @relation("RequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo User?     @relation("RequestAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  items      RequestItem[]
  operations RequestOperation[]
  receivings Receiving[]

  @@index([warehouseId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@index([createdAt])
  @@map("requests")
}

// ============================================================
// REQUEST ITEM
// ============================================================

model RequestItem {
  id        String @id @default(uuid()) @db.Uuid
  requestId String @db.Uuid
  productId String @db.Uuid

  requestedQuantity Int
  receivedQuantity  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  operations     RequestOperation[]
  receivingItems ReceivingItem[]

  @@unique([requestId, productId])
  @@index([requestId])
  @@index([productId])
  @@map("request_items")
}

// ============================================================
// REQUEST OPERATION
// ============================================================

model RequestOperation {
  id String @id @default(uuid()) @db.Uuid

  requestId     String  @db.Uuid
  requestItemId String? @db.Uuid

  assignedToId  String? @db.Uuid
  completedById String? @db.Uuid

  type   RequestOperationType
  status RequestOperationStatus @default(PENDING)

  quantity Int?

  notes String? @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  request     Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestItem RequestItem? @relation(fields: [requestItemId], references: [id], onDelete: SetNull)

  assignedTo  User? @relation("OperationAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  completedBy User? @relation("OperationCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([requestItemId])
  @@index([assignedToId])
  @@index([status])
  @@index([type])
  @@map("request_operations")
}

// ============================================================
// RECEIVING
// ============================================================

model Receiving {
  id String @id @default(uuid()) @db.Uuid

  number String @unique @db.VarChar(50)

  requestId    String? @db.Uuid
  warehouseId  String  @db.Uuid
  receivedById String? @db.Uuid

  status ReceivingStatus @default(CREATED)

  startedAt   DateTime?
  completedAt DateTime?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request    Request?  @relation(fields: [requestId], references: [id], onDelete: SetNull)
  warehouse  Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receivedBy User?     @relation("ReceivingReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  items ReceivingItem[]
  boxes Box[]

  @@index([requestId])
  @@index([warehouseId])
  @@index([receivedById])
  @@index([status])
  @@index([createdAt])
  @@map("receivings")
}

// ============================================================
// RECEIVING ITEM
// ============================================================

model ReceivingItem {
  id String @id @default(uuid()) @db.Uuid

  receivingId  String  @db.Uuid
  requestItemId String? @db.Uuid
  productId    String  @db.Uuid

  expectedQuantity Int?
  receivedQuantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receiving   Receiving    @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  requestItem RequestItem? @relation(fields: [requestItemId], references: [id], onDelete: SetNull)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  boxItems BoxItem[]

  @@index([receivingId])
  @@index([requestItemId])
  @@index([productId])
  @@map("receiving_items")
}

// ============================================================
// BOX
// ============================================================

model Box {
  id String @id @default(uuid()) @db.Uuid

  warehouseId String  @db.Uuid
  receivingId String? @db.Uuid

  currentLocationId String? @db.Uuid

  barcode String @unique @db.VarChar(100)

  status BoxStatus @default(OPEN)

  description String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sealedAt  DateTime?
  closedAt  DateTime?

  warehouse       Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receiving       Receiving? @relation(fields: [receivingId], references: [id], onDelete: SetNull)
  currentLocation Location?  @relation(fields: [currentLocationId], references: [id], onDelete: SetNull)

  items              BoxItem[]
  movements          BoxMovement[]
  inventory          Inventory[]
  inventoryMovements InventoryMovement[]

  @@index([warehouseId])
  @@index([receivingId])
  @@index([currentLocationId])
  @@index([status])
  @@map("boxes")
}

// ============================================================
// BOX ITEM
// ============================================================

model BoxItem {
  id String @id @default(uuid()) @db.Uuid

  boxId          String  @db.Uuid
  productId      String  @db.Uuid
  receivingItemId String? @db.Uuid

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  box           Box            @relation(fields: [boxId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  receivingItem ReceivingItem? @relation(fields: [receivingItemId], references: [id], onDelete: SetNull)

  @@unique([boxId, productId])
  @@index([boxId])
  @@index([productId])
  @@index([receivingItemId])
  @@map("box_items")
}

// ============================================================
// BOX MOVEMENT
// ============================================================

model BoxMovement {
  id String @id @default(uuid()) @db.Uuid

  boxId String @db.Uuid

  fromLocationId String? @db.Uuid
  toLocationId   String  @db.Uuid

  movedById String? @db.Uuid

  createdAt DateTime @default(now())

  notes String? @db.Text

  box Box @relation(fields: [boxId], references: [id], onDelete: Restrict)

  fromLocation Location? @relation("BoxMovementFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   Location  @relation("BoxMovementToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)

  movedBy User? @relation("BoxMovementMovedBy", fields: [movedById], references: [id], onDelete: SetNull)

  @@index([boxId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([movedById])
  @@index([createdAt])
  @@map("box_movements")
}

// ============================================================
// Client
// ============================================================
model Client {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(255)
  clientType String   @map("client_type") @db.VarChar(100)
  email      String?  @db.VarChar(255)
  phone      String?  @db.VarChar(50)
  isActive   Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientType])
  @@index([isActive])
  @@map("clients")
}

// ============================================================
// INVENTORY
// ============================================================

model Inventory {
  id String @id @default(uuid()) @db.Uuid

  warehouseId String  @db.Uuid
  locationId  String  @db.Uuid
  productId   String  @db.Uuid
  boxId       String? @db.Uuid

  quantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location  Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  box       Box?      @relation(fields: [boxId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, locationId, productId, boxId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([productId])
  @@index([boxId])
  @@map("inventory")
}

// ============================================================
// INVENTORY MOVEMENT
// ============================================================

model InventoryMovement {
  id String @id @default(uuid()) @db.Uuid

  warehouseId String  @db.Uuid
  productId   String  @db.Uuid
  boxId       String? @db.Uuid

  fromLocationId String? @db.Uuid
  toLocationId   String? @db.Uuid

  performedById String? @db.Uuid

  type InventoryMovementType

  quantity Int

  reason String? @db.Text

  createdAt DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  box       Box?      @relation(fields: [boxId], references: [id], onDelete: Restrict)

  fromLocation Location? @relation("InventoryMovementFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   Location? @relation("InventoryMovementToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)

  performedBy User? @relation("InventoryMovementPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([warehouseId])
  @@index([productId])
  @@index([boxId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([performedById])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_movements")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  userId String? @db.Uuid

  action     AuditAction
  entityType String  @db.VarChar(100)
  entityId   String? @db.VarChar(100)

  description String? @db.Text

  metadata Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}